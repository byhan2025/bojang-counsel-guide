# 로컬 함수 실행용 시크릿 예시 — `cp supabase/.env.local.example supabase/.env.local`
# supabase functions serve --env-file ./supabase/.env.local
# (원격에서는 `supabase secrets set` 으로 등록합니다. 이 파일은 커밋하지 않습니다.)

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<supabase start 출력의 anon key>
SUPABASE_SERVICE_ROLE_KEY=<supabase start 출력의 service_role key>

# AI 비전 — OpenAI 또는 Gemini 중 하나만 있으면 됩니다.
OPENAI_API_KEY=
VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# 결제 (테스트)
TOSS_SECRET_KEY=
PORTONE_API_SECRET=
PG_WEBHOOK_SECRET=change-me-local-only
BILLING_TEST_MODE=true
